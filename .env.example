# =============================================================================
# SANAD — environment variables
# Copy to `.env` and fill in real values locally. `.env` is git-ignored.
# Never commit real keys, and never paste them into chats or issues.
# =============================================================================

# --- Supabase (Dashboard → Project Settings → API / API Keys) -----------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=""

# Server-only secret key (sb_secret_…). Bypasses RLS — used only by server.ts and scripts.
# Legacy projects: you may set SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=""

# Publishable key (sb_publishable_…). Used for user-scoped (RLS-enforced) queries.
# Legacy projects: you may set SUPABASE_ANON_KEY instead.
SUPABASE_PUBLISHABLE_KEY=""

# --- Supabase CLI (only for `npm run db:link` / `db:push`) --------------------
# Project ref = the <project-ref> part of SUPABASE_URL.
SUPABASE_PROJECT_REF=""
# Database password chosen when the project was created (Dashboard → Database → Settings).
SUPABASE_DB_PASSWORD=""

# --- Local development & tests (optional; plain PostgreSQL 15+ with pgvector) -
# Used by `npm run db:migrate:local` and the database test suite. Never a Supabase host.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sanad"
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
# POSTGREST_BIN="/path/to/postgrest"   # enables the repository tests through a real PostgREST

# --- Server -------------------------------------------------------------------
PORT=3000

# --- Answer path: language model (server-side only) ---------------------------
# Used ONLY to understand the question (language, intent, search keywords) and to pick which
# approved text answers it. It never writes religious content. Without a key the site still works
# with stricter keyword rules (more questions are referred to a daee).
# Any OpenAI-compatible chat endpoint. Default: Gemini (key from https://aistudio.google.com/apikey).
LLM_API_KEY=""
# LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# LLM_MODEL="gemini-3.5-flash-lite"
# To use an OpenAI key (sk-…) instead:
# LLM_BASE_URL="https://api.openai.com/v1/"
# LLM_MODEL="gpt-4.1-mini"

# Approved corpus built by `npm run corpus:build` (default: data/corpus/corpus.json.gz)
# CORPUS_FILE=""
